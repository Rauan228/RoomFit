[Unit]
Description=RoomFit private photo furniture processor
After=network.target postgresql.service roomfit-api.service

[Service]
Type=simple
User=roomfit
Group=roomfit
WorkingDirectory=/opt/roomfit/api
EnvironmentFile=/opt/roomfit/api/.env
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=2
ExecStart=/opt/roomfit/api/.venv/bin/python -m roomfit.photo_jobs
Restart=on-failure
RestartSec=5
Nice=10
CPUQuota=100%
MemoryMax=2G
TasksMax=100
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/roomfit/api/data

[Install]
WantedBy=multi-user.target
