{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "../packages/core/src", "vite.config.ts"],
  "exclude": [
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "../packages/core/src/**/*.test.*",
    "../packages/core/src/**/*.spec.*"
  ]
}
