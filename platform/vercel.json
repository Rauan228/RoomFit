{
  "framework": "vite",
  "installCommand": "cd .. && npm ci --include=dev --workspace=@roomfit/platform --workspace=@roomfit/core --include-workspace-root=false",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://roomfit.212.19.134.179.sslip.io/api/:path*"
    },
    { "source": "/((?!assets/|api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
