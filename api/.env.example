DATABASE_URL=sqlite:///./data/roomfit.db
APP_ENV=development
COOKIE_SECURE=false
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
FRONTEND_URL=http://127.0.0.1:4181
ALLOWED_ORIGINS=http://127.0.0.1:4181,http://localhost:4181
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Private photo furniture. Paid generation is disabled until explicitly enabled.
TRIPO_API_KEY=
TRIPO_ENABLED=false
TRIPO_MODEL_VERSION=v3.1-20260211
TRIPO_DAILY_CREDIT_LIMIT=0
# 0 = no lifetime cap; set a positive value to enforce the authorized total budget.
TRIPO_TOTAL_CREDIT_LIMIT=40
TRIPO_USER_DAILY_LIMIT=1
TRIPO_MAX_CONCURRENT_JOBS=1
TRIPO_JOB_CREDIT_RESERVE=40
ROOMFIT_BLENDER=
ROOMFIT_PHOTO_STORAGE=data/photo-furniture
ROOMFIT_PHOTO_USER_STORAGE_MB=500
